            line_amt[word].append(line_num)

    line_num += 1

# exit()
one_occurence = []

def seperate(values, predicate):
    passed = []
    failed = []
    
    for e in values:
        if predicate(e):
            passed.append(e)
        else:
            failed.append(e)

    return (passed, failed)

multiples, singles = seperate(line_amt.items(), lambda pair: len(pair[1]) > 1)
#print(multiples)
#print(singles)

longest = sorted(multiples, key = lambda t: len(t[0]))[-1]
#print(f"Longest: {longest}")

pairs = sorted(line_amt.items(), key = lambda t: 1/len(t[1]))

width = len(longest[0]) 
